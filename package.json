{
  "name": "snoopy-bank",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pages": "vite build && wrangler pages dev dist --d1=DB=snoopy-db",
    "db:init:local": "wrangler d1 execute snoopy-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute snoopy-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "isomorphic-git": "^1.41.9",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "wrangler": "^4.129.0"
  }
}
